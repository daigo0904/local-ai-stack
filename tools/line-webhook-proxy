#!/usr/bin/env python3
"""
line-webhook-proxy — LINE の Webhook だけを OpenClaw ゲートウェイに通す中継。

cloudflared でトンネルを張るとゲートウェイ全体（管理画面・API・WebSocket）が
インターネットから見える状態になってしまう。この中継を間に挟むことで、
外から届くのは LINE の Webhook パスだけになる。

    インターネット → cloudflared → この中継(18790) → OpenClaw(18789)

使い方:
    line-webhook-proxy            # 18790 で待ち受け
    LISTEN_PORT=9000 line-webhook-proxy
"""

import http.server
import os
import socketserver
import sys
import urllib.error
import urllib.request

LISTEN_PORT = int(os.environ.get("LISTEN_PORT", "18790"))
UPSTREAM = os.environ.get("UPSTREAM", "http://127.0.0.1:18789")
ALLOWED_PATH = os.environ.get("WEBHOOK_PATH", "/line/webhook")
MAX_BODY = 64 * 1024  # LINE 署名検証の前提に合わせた上限

# 転送しないヘッダ（ホップバイホップ）
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailers", "transfer-encoding", "upgrade", "host", "content-length",
}


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "line-webhook-proxy"
    sys_version = ""

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _deny(self, code=404):
        body = b"not found\n"
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _forward(self, method):
        # パスが違えば即座に拒否する。ここが唯一の入口。
        path = self.path.split("?", 1)[0]
        if path != ALLOWED_PATH:
            self.log_message("blocked %s %s", method, self.path)
            self._deny()
            return

        length = int(self.headers.get("Content-Length") or 0)
        if length > MAX_BODY:
            self._deny(413)
            return
        body = self.rfile.read(length) if length else None

        req = urllib.request.Request(UPSTREAM + self.path, data=body, method=method)
        for k, v in self.headers.items():
            if k.lower() not in HOP_BY_HOP:
                req.add_header(k, v)

        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                data = r.read()
                status, headers = r.status, r.headers
        except urllib.error.HTTPError as e:
            data = e.read()
            status, headers = e.code, e.headers
        except Exception as e:
            self.log_message("upstream error: %s", e)
            self._deny(502)
            return

        self.send_response(status)
        for k, v in headers.items():
            if k.lower() not in HOP_BY_HOP:
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self._forward("GET")

    def do_POST(self):
        self._forward("POST")

    def do_HEAD(self):
        self._deny()

    def do_PUT(self):
        self._deny()

    def do_DELETE(self):
        self._deny()


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    sys.stderr.write(
        f"line-webhook-proxy: 127.0.0.1:{LISTEN_PORT} -> {UPSTREAM}{ALLOWED_PATH} のみ許可\n"
    )
    Server(("127.0.0.1", LISTEN_PORT), Handler).serve_forever()
