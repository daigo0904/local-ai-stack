#!/usr/bin/env python3
"""
casual-ping — 気まぐれな声かけを1通つくる。

毎回同じ文面だと飽きるので、その時の状況（時間帯・vaultの状態）を材料にして
qwen3 に短い一言を書かせる。深夜は黙る。

    casual-ping           # 声をかける（黙るときは何も出力しない）
    casual-ping --force   # 時間帯に関係なく出力する
"""

import json
import os
import random
import re
import sys
import urllib.request
from datetime import datetime, timedelta

OLLAMA = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434") + "/api/chat"
MODEL = os.environ.get("RESEARCH_MODEL", "qwen3:14b-q4_K_M")
INBOX = os.path.expanduser("~/知識メモ/Inbox")
QUIET_START, QUIET_END = 23, 8  # この時間帯は黙る


def vault_state():
    """vault の様子を短い日本語にする。声かけの材料。"""
    if not os.path.isdir(INBOX):
        return "ノートはまだありません。"
    files = [f for f in os.listdir(INBOX) if f.endswith(".md")]
    if not files:
        return "ノートはまだ1件もありません。"
    now = datetime.now()
    recent = [
        f for f in files
        if now - datetime.fromtimestamp(os.path.getmtime(os.path.join(INBOX, f))) < timedelta(days=1)
    ]
    newest = max(files, key=lambda f: os.path.getmtime(os.path.join(INBOX, f)))
    # ファイル名ではなく、ノート本文の title: を使う（ファイル名は読みにくいため）
    title = ""
    try:
        with open(os.path.join(INBOX, newest), encoding="utf-8") as f:
            head = f.read(600)
        m = re.search(r"^title:\s*(.+)$", head, re.M)
        if m:
            title = m.group(1).strip()
    except OSError:
        pass
    if not title:
        title = newest[11:-3].replace("-", " ")

    return (f"保存済みのノートは全部で{len(files)}件です。"
            f"そのうち直近24時間に増えたのは{len(recent)}件です。"
            f"最後に保存したノートのタイトルは「{title}」です。"
            f"（この件数を勝手に増減させて書かないこと）")


def quota_ok(need=60):
    """LINEの残り送信数が少ないときは声かけを見送る。
    声かけは3つの発信のうち最も重要度が低いので、まずこれから止める。"""
    quota = os.path.expanduser("~/bin/line-quota")
    if not os.path.isfile(quota):
        return True
    try:
        import subprocess
        return subprocess.run([quota, "--check", str(need)],
                              capture_output=True, timeout=30).returncode == 0
    except Exception:
        return True  # 判定できないときは止めない


def main():
    force = "--force" in sys.argv
    hour = datetime.now().hour
    if not force and (hour >= QUIET_START or hour < QUIET_END):
        return 0  # 深夜は黙る
    if not force and not quota_ok(60):
        return 0  # 残りが少ないときは調査枠を守るため黙る

    angles = [
        "相手の調子をさりげなく尋ねる",
        "最近ためた知識に関連して、ひとつ豆知識を添える",
        "溜まっているノートを見返すことを軽くすすめる",
        "今の時間帯に合った、ひとことねぎらう",
        "最近調べた話題について、続けて調べると面白そうなことを1つ提案する",
    ]
    angle = random.choice(angles)

    system = (
        "あなたはユーザーの個人アシスタントです。LINEで短い声かけを1通だけ送ります。\n"
        "条件:\n"
        "- 日本語で、2文以内。長くしない。\n"
        "- 挨拶だけで終わらせず、相手が返事しやすい一言を入れる。\n"
        "- 絵文字は使っても1つまで。\n"
        "- 事実を作らない。渡された情報だけを使う。\n"
        "- 前置き（「わかりました」等）は書かず、送る本文だけを出力する。"
    )
    user = (
        f"今は{datetime.now().strftime('%-m月%-d日 %-H時')}ごろです。\n"
        f"{vault_state()}\n"
        f"今回の切り口: {angle}\n"
        "この材料で、送る本文だけを書いてください。"
    )

    body = json.dumps({
        "model": MODEL, "stream": False, "think": False, "keep_alive": "30m",
        "options": {"num_ctx": 8192, "temperature": 0.9, "top_p": 0.95},
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": user}],
    }).encode()

    try:
        req = urllib.request.Request(OLLAMA, data=body,
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=300) as r:
            d = json.loads(r.read())
        text = (d.get("message", {}).get("content") or "").strip()
    except Exception:
        return 0  # 失敗しても黙る。声かけで通知が壊れるのは避ける。

    if not text or "NO_REPLY" in text:
        return 0
    print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
