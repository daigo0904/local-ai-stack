def cmd_seal(a):
    try:
        contract = load_contract(a.contract)
    except (OSError, ValueError) as e:
        print(f"proofcheck: {e}", file=sys.stderr)
        return EXIT_USAGE
    ws = os.path.abspath(a.workspace)
    run = os.path.abspath(a.run)
    if not os.path.isdir(ws):
        print(f"proofcheck: 作業場が無い: {ws}", file=sys.stderr)
        return EXIT_USAGE
    if run == ws or run.startswith(ws + os.sep):
        print("proofcheck: RUNDIR を作業場の中に置かない（エージェントが書き換えられる）",
              file=sys.stderr)
        return EXIT_USAGE
    if os.path.exists(run) and os.listdir(run):
        print(f"proofcheck: RUNDIR が空ではない: {run}", file=sys.stderr)
        return EXIT_USAGE
    ignore = DEFAULT_IGNORE + contract["ignore"]
    os.makedirs(run, exist_ok=True)
    copy_tree(ws, os.path.join(run, "baseline"))
    seal = {
        "format": 1,
        "sealed_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "workspace": ws,
        "contract": contract,
        "contract_sha256": hashlib.sha256(
            json.dumps(contract, sort_keys=True, ensure_ascii=False).encode()).hexdigest(),
        "manifest": manifest(ws, ignore),
    }
    path = os.path.join(run, "seal.json")
    with open(path, "w") as f:
        json.dump(seal, f, ensure_ascii=False, indent=1, sort_keys=True)
    sid = sha256_file(path)
    print(f"封印した  {len(seal['manifest'])} 件・契約 {seal['contract_sha256'][:12]}")
    print(f"封印ID    {sid}")
    print(f"判定:     proofcheck judge {run} --seal-id {sid} --claim '…'")
    return 0


def cmd_judge(a):
    run = os.path.abspath(a.run)
    path = os.path.join(run, "seal.json")
    try:
        sid = sha256_file(path)
        with open(path) as f:
            seal = json.load(f)
    except (OSError, ValueError) as e:
        print(f"proofcheck: 封印が読めない: {e}", file=sys.stderr)
        return EXIT_USAGE
    if a.seal_id and a.seal_id != sid:
        print("proofcheck: 封印IDが違う。封印が書き換えられているので判定しない", file=sys.stderr)
        return EXIT_USAGE
    if a.claim_file:
        with open(a.claim_file) as f:
            claim_text = f.read()
    else:
        claim_text = a.claim or ""
    harness = load_codex_events(a.codex_jsonl) if a.codex_jsonl else None
    if not claim_text and harness and harness.get("agent_message"):
        # 申告を渡されなければ、ハーネスに残ったエージェントの最後の発言を申告として読む
        claim_text = harness["agent_message"]
    receipt = merge_evidence(load_receipt(a.receipt) if a.receipt else None, harness)
    rw = (receipt or {}).get("workspace")
    if rw and os.path.realpath(rw) != os.path.realpath(seal["workspace"]):
        # 別の走りの受領証で判定すると、他人の差分で採点することになる
        print(f"proofcheck: 受領証の作業場（{rw}）が封印した作業場と違う。判定しない", file=sys.stderr)
        return EXIT_USAGE

    c = seal["contract"]
    ws = seal["workspace"]
    ignore = DEFAULT_IGNORE + c["ignore"]
    before = seal["manifest"]
    after = manifest(ws, ignore)
    d = diff(before, after)

    base = os.path.join(run, "baseline")
    cmds = list(dict.fromkeys(c.get("repro", []) + c.get("must_pass", []) + c.get("keep_passing", [])))
    base_runs, final_runs = {}, {}
    with tempfile.TemporaryDirectory(prefix="proofcheck-") as tmp:
        b_ws = os.path.join(tmp, "before")
        f_ws = os.path.join(tmp, "after")
        copy_tree(base, b_ws)
        reverted = restored_copy(ws, base, before, after, c, f_ws)
        for cmd in cmds:
            base_runs[cmd] = run_cmd(cmd, b_ws, c["timeout_sec"])
            final_runs[cmd] = run_cmd(cmd, f_ws, c["timeout_sec"])

    claims = decompose(claim_text)
    claim_items = judge_claims(claims, c, d, final_runs, base_runs, receipt)
    contract_items = judge_contract(c, d, final_runs, base_runs, receipt)
    report = {
        "format": 1,
        "judged_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "seal_id": sid,
        "task": c.get("task", ""),
        "claim_text": claim_text,
        "verdict": overall(claim_items + contract_items),
        "claims": claim_items,
        "contract": contract_items,
        "diff": d,
        "reverted_before_testing": reverted,
        "runs": {"before": base_runs, "after": final_runs},
        "receipt": receipt,
    }
    with open(os.path.join(run, "report.json"), "w") as f:
        json.dump(report, f, ensure_ascii=False, indent=1)
    if a.json:
        print(json.dumps(report, ensure_ascii=False, indent=1))
    else:
        print_report(report)
    return EXIT[report["verdict"]]


MARK = {PROVEN: "○ PROVEN    ", DISPROVEN: "× DISPROVEN ", UNVERIFIED: "? UNVERIFIED"}


def print_report(r):
    print(f"判定: {r['verdict']}" + (f"  — {r['task']}" if r["task"] else ""))
    d = r["diff"]
    print(f"作業場の変化: 追加 {len(d['added'])}・削除 {len(d['removed'])}・変更 {len(d['changed'])}")
    if r["reverted_before_testing"]:
        print(f"テスト前に元へ戻したもの: {', '.join(r['reverted_before_testing'])}")
    for title, items in (("申告", r["claims"]), ("契約", r["contract"])):
        print(f"\n{title}")
        if not items:
            print("  （申告から claim を取り出せなかった）")
        for i in items:
            print(f"  {MARK[i['verdict']]}  {i['text']}  [{i['basis']}]")
            for e in i["evidence"]:
                print(f"      証拠: {e}")
            for m in i["missing"]:
                print(f"      足りない証拠: {m}")


def main(argv=None):
    p = argparse.ArgumentParser(prog="proofcheck", description="申告を実行の証拠と突き合わせて三値で判定する")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("seal", help="成功の条件と作業場を、実行の前に封印する")
    s.add_argument("contract")
    s.add_argument("--workspace", required=True)
    s.add_argument("--run", required=True, help="封印の置き場（作業場の外・エージェントの届かない場所）")
    j = sub.add_parser("judge", help="仕事のあとで、申告と契約を判定する")
    j.add_argument("run")
    g = j.add_mutually_exclusive_group()
    g.add_argument("--claim", help="エージェントの申告（完了報告の文）")
    g.add_argument("--claim-file")
    j.add_argument("--receipt", help="guardrun の受領証（JSON）")
    j.add_argument("--codex-jsonl", help="codex exec --json（または qwc --events）の記録。--claim が無ければ最後の発言を申告に使う")
    j.add_argument("--seal-id", help="seal が出した封印ID。違えば判定しない")
    j.add_argument("--json", action="store_true")
    a = p.parse_args(argv)
    return cmd_seal(a) if a.cmd == "seal" else cmd_judge(a)


if __name__ == "__main__":
    sys.exit(main())
