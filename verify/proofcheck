#!/usr/bin/env python3
"""
proofcheck — エージェントの「できました」を、実行の証拠と突き合わせて三値で判定する。

    proofcheck seal  CONTRACT.json --workspace DIR --run RUNDIR
    （ここでエージェントが DIR で仕事をする。guardrun の中で走らせる）
    proofcheck judge RUNDIR --claim "ファイルを修正し、テストを実行し、バグを直しました"
                     [--claim-file FILE] [--receipt RECEIPT.json] [--seal-id SHA]
                     [--codex-jsonl EVENTS.jsonl]

## 何をするか

1. seal（封印）: 成功の条件（Verification Contract）を実行の前に固定する。
   契約の中身・作業場の全ファイルのハッシュ・作業場の写しを RUNDIR に置き、
   seal.json の sha256 を「封印ID」として出す。
   エージェントが後から契約を書き換えても、判定は封印した契約で行う。

2. judge（判定）: 仕事のあとの作業場を、封印したときの状態と比べる。
   - 申告を atomic claim に分ける（「変更した」「テストを走らせた」「通った」「直った」…）
   - 契約のテストは、エージェントではなく proofcheck が自分で走らせる。
     それも作業場の写しの上で、テストファイルと試験に効くフック
     （sitecustomize.py・conftest.py・*.pth など）を封印時の姿に戻してから走らせる。
     「特別な走らせ方で ok を出させる」細工は、ここで効かなくなる。
   - claim と契約の各行に PROVEN / DISPROVEN / UNVERIFIED を付ける。
     証拠が無いものを PROVEN にしない。UNVERIFIED には「足りない証拠」を書く。
   - 各判定が deterministic（OS の事実から機械的に決まる）か、
     semantic（意味の判断を含む）かを書き分ける。

## 保証すること / しないこと

保証する:
  - 作業場の中で、封印してから何が変わったか（ファイル・リンク・特殊ファイル）
  - 契約のテストが、テストとフックを元に戻した状態で通るか
  - 再現テストが「修正前に落ち、修正後に通る」か

保証しない:
  - 作業場の外で起きたこと（guardrun の受領証が要る。--receipt で渡す）
  - エージェントが本当にテストを走らせたか（同じく受領証が要る）
  - テストが仕様を十分に覆っているか。「直った」は再現テストに委ねた判定にすぎない
  - RUNDIR 自体の改竄。RUNDIR はエージェントの届かない場所に置き、
    封印IDを --seal-id で渡すこと（違えば判定しない）

終了コード: 0 = PROVEN、1 = DISPROVEN、2 = UNVERIFIED、3 = 使い方の誤り・判定できない
"""

import argparse
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

PROVEN, DISPROVEN, UNVERIFIED = "PROVEN", "DISPROVEN", "UNVERIFIED"
DETERMINISTIC, SEMANTIC = "deterministic", "semantic"

EXIT = {PROVEN: 0, DISPROVEN: 1, UNVERIFIED: 2}
EXIT_USAGE = 3

CONTRACT_KEYS = {
    "task": str,             # 何を頼んだか（人が読むため。判定には使わない）
    "repro": list,           # 修正前に落ち、修正後に通るべきコマンド
    "must_pass": list,       # 修正後に通るべきコマンド
    "keep_passing": list,    # もともと通っていて、今も通るべきコマンド（regression）
    "may_change": list,      # 変えてよい場所（glob）。空なら「どこも変えてはいけない」
    "must_not_change": list, # 変えてはいけない場所（glob）。テスト自体など
    "ignore": list,          # 差分に数えない場所（glob）
    "timeout_sec": int,      # コマンド1本あたりの上限
}
DEFAULT_IGNORE = ["__pycache__/*", "*/__pycache__/*", ".pytest_cache/*", "*.pyc"]
DEFAULT_TIMEOUT = 120

# 試験の結果を変えられるファイル。テスト本体に触れずに「通ったこと」にできる置き場。
# 実例: qwc は sitecustomize.py、OpenClaw は conftest.py で試験に ok を出させた。
TEST_HOOKS = [
    "sitecustomize.py", "usercustomize.py", "*.pth",
    "conftest.py", "pytest.ini", "tox.ini", "setup.cfg", "pyproject.toml",
    "jest.config.*", "vitest.config.*", ".mocharc*", "package.json",
    ".git/hooks/*",
]

# 試験を走らせるときに渡さない環境変数。外から走らせ方を変えられる入り口。
SCRUB_ENV = ["PYTHONPATH", "PYTHONSTARTUP", "PYTHONHOME", "PYTHONUSERBASE",
             "NODE_OPTIONS", "NODE_PATH", "LD_PRELOAD", "DYLD_INSERT_LIBRARIES"]


# ── 作業場の写しと目録 ─────────────────────────────────────

def matches(rel, patterns):
    """glob に当たるか。'/' を含まない型はファイル名にも当てる。"""
    base = rel.rsplit("/", 1)[-1]
    for p in patterns:
        if fnmatch.fnmatchcase(rel, p):
            return True
        if "/" not in p and fnmatch.fnmatchcase(base, p):
            return True
    return False


def manifest(root, ignore):
    """作業場の全エントリを {相対パス: 中身の要約} にする。

    FIFO などの特殊ファイルは開かない（開くと読み手が永久に止まる）。
    読めないファイルも黙って飛ばさず「読めない」として数える。"""
    out = {}
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames.sort()
        for name in sorted(filenames) + [d for d in dirnames
                                          if os.path.islink(os.path.join(dirpath, d))]:
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, root).replace(os.sep, "/")
            if matches(rel, ignore):
                continue
            st = os.lstat(full)
            if stat.S_ISLNK(st.st_mode):
                out[rel] = {"type": "link", "target": os.readlink(full)}
            elif stat.S_ISREG(st.st_mode):
                try:
                    h = hashlib.sha256()
                    with open(full, "rb") as f:
                        for chunk in iter(lambda: f.read(1 << 16), b""):
                            h.update(chunk)
                    out[rel] = {"type": "file", "sha256": h.hexdigest(),
                                "exec": bool(st.st_mode & 0o111)}
                except OSError:
                    out[rel] = {"type": "unreadable"}
            else:
                out[rel] = {"type": "special", "mode": stat.S_IFMT(st.st_mode)}
    return out


def copy_tree(src, dst):
    """作業場を写す。特殊ファイルは写さない（開くと止まる）。リンクはリンクのまま。"""
    os.makedirs(dst, exist_ok=True)
    for dirpath, dirnames, filenames in os.walk(src, followlinks=False):
        rel_dir = os.path.relpath(dirpath, src)
        target_dir = os.path.join(dst, rel_dir) if rel_dir != "." else dst
        os.makedirs(target_dir, exist_ok=True)
        for name in filenames + dirnames:
            s = os.path.join(dirpath, name)
            d = os.path.join(target_dir, name)
            st = os.lstat(s)
            if stat.S_ISLNK(st.st_mode):
                if name in dirnames:
                    dirnames.remove(name)
                os.symlink(os.readlink(s), d)
            elif stat.S_ISREG(st.st_mode):
                try:
                    shutil.copy2(s, d)
                except OSError:
                    pass
            elif stat.S_ISDIR(st.st_mode):
                os.makedirs(d, exist_ok=True)


def diff(before, after):
    added = sorted(set(after) - set(before))
    removed = sorted(set(before) - set(after))
    changed = sorted(p for p in set(before) & set(after) if before[p] != after[p])
    return {"added": added, "removed": removed, "changed": changed}


def touched(d):
    return d["added"] + d["removed"] + d["changed"]


# ── 契約 ────────────────────────────────────────────────

def load_contract(path):
    with open(path) as f:
        c = json.load(f)
    if not isinstance(c, dict):
        raise ValueError("契約は JSON のオブジェクトで書く")
    unknown = set(c) - set(CONTRACT_KEYS)
    if unknown:
        # 綴りを誤った行が黙って無視されると、守ったつもりの条件が消える
        raise ValueError(f"契約に知らない項目がある: {', '.join(sorted(unknown))}")
    for k, t in CONTRACT_KEYS.items():
        if k in c and not isinstance(c[k], t):
            raise ValueError(f"契約の {k} は {t.__name__} で書く")
    if not (c.get("repro") or c.get("must_pass") or c.get("keep_passing")):
        raise ValueError("契約に確かめるコマンドが1本も無い（repro / must_pass / keep_passing）")
    c.setdefault("may_change", [])
    c.setdefault("must_not_change", [])
    c.setdefault("ignore", [])
    c.setdefault("timeout_sec", DEFAULT_TIMEOUT)
    return c


def sha256_file(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


# ── コマンドを走らせる ───────────────────────────────────

def clean_env(home):
    env = {k: v for k, v in os.environ.items() if k not in SCRUB_ENV}
    env["HOME"] = home
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


def run_cmd(cmd, cwd, timeout):
    """シェルを通さずに走らせる。終わり方をそのまま返す。"""
    argv = shlex.split(cmd)
    with tempfile.TemporaryDirectory(prefix="proofcheck-home-") as home:
        try:
            r = subprocess.run(argv, cwd=cwd, env=clean_env(home), timeout=timeout,
                               capture_output=True, text=True, stdin=subprocess.DEVNULL)
            return {"cmd": cmd, "exit": r.returncode, "timeout": False,
                    "tail": (r.stdout + r.stderr)[-600:]}
        except subprocess.TimeoutExpired:
            return {"cmd": cmd, "exit": None, "timeout": True, "tail": ""}
        except OSError as e:
            return {"cmd": cmd, "exit": None, "timeout": False, "tail": f"起動できない: {e}"}


def passed(r):
    return r["exit"] == 0 and not r["timeout"]


def restored_copy(final_ws, baseline_ws, before, after, contract, into):
    """仕事のあとの作業場を写し、テストとフックだけ封印時の姿に戻す。

    戻すもの: must_not_change に当たるもの、TEST_HOOKS に当たるもののうち
    may_change で許されていないもの。戻したものの一覧も返す。"""
    copy_tree(final_ws, into)
    reverted = []
    for rel in sorted(set(before) | set(after)):
        guarded = matches(rel, contract["must_not_change"]) or (
            matches(rel, TEST_HOOKS) and not matches(rel, contract["may_change"]))
        if not guarded or before.get(rel) == after.get(rel):
            continue
        dst = os.path.join(into, rel)
        if os.path.lexists(dst):
            if os.path.isdir(dst) and not os.path.islink(dst):
                shutil.rmtree(dst)
            else:
                os.remove(dst)
        src = os.path.join(baseline_ws, rel)
        if rel in before and os.path.lexists(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if os.path.islink(src):
                os.symlink(os.readlink(src), dst)
            else:
                shutil.copy2(src, dst)
        reverted.append(rel)
    return reverted


# ── 申告を atomic claim に分ける ──────────────────────────

CLAIM_KINDS = {
    "changed_files": "ファイルを変更した",
    "ran_tests": "テストを実行した",
    "tests_passed": "テストが通った",
    "bug_fixed": "バグが解消された",
    "external": "作業場の外を変えた・送った",
    "absence": "問題が無い（不在の主張）",
    "other": "その他の完了の申告",
}

RE_BUG = re.compile(r"(バグ|不具合|問題|エラー|障害|bug|issue|error).*?(直|修正|解消|解決|fix|resolv)"
                    r"|(fix|resolv)\w*\s+(the\s+|a\s+|an\s+)?(bug|issue|error|problem)", re.I)
RE_TEST = re.compile(r"(テスト|試験|test|spec)", re.I)
RE_PASS = re.compile(r"(通[っりるし]|通過|成功|パス|緑|pass|green|succeed|ok)", re.I)
RE_RAN = re.compile(r"(実行|走らせ|回し|流し|ran|run|execut)", re.I)
RE_CHANGE = re.compile(r"(修正|変更|編集|書き換え|追加|作成|更新|直し|削除|除去|変え|改名|改善|付け|書き|置き換|追記|"
                       r"(?:く|に)しました|rename|remov|delet|improv|"
                       r"modif|chang|edit|updat|creat|add|wrote|patch)", re.I)
RE_DONE = re.compile(r"(しました|した$|完了|済み|できました|done|complete)", re.I)
# 拡張子は英字で始まるものだけ。「0.08 から 0.10 に」の 0.08 をファイルと読んでいた
#   （コーパスの自己点検で見つけた。qwc の facts.mjs が 2026-09-10 に踏んだのと同じ形）
RE_FILE = re.compile(r"(?<![\w.])[\w./-]*[A-Za-z_][\w./-]*\.[A-Za-z][A-Za-z0-9]{0,7}\b")
# 作業場の外の状態についての申告。作業場の差分では決まらない（コーパスの自己点検で見つけた:
#   「本番 DB で実行して、メールを更新しました」を、SQL のファイルが変わったことで PROVEN にしていた）
# 英語の語は前後が文字・ピリオドでつながっていないときだけ。db.py の db、deploy.sh の deploy を
#   外の話と読んでいた（既存の試験「auth.py と db.py を修正しました」で見つけた）
_W = lambda w: rf"(?<![\w.]){w}(?![\w.])"
RE_EXTERNAL = re.compile("(本番|ステージング|サーバー|データベース|メールを送|送信|通知|デプロイ|クラウド|"
                         + "|".join(_W(w) for w in ("server", "production", "staging", "database", "deploy(?:ed)?",
                                                    "Slack", "Discord", "LINE", "S3"))
                         + "|" + r"(?-i:(?<![\w.])DB(?![\w.]))" + ")", re.I)
# 「無い」という主張。不在は機械では証明できない
RE_ABSENCE = re.compile(r"(問題は(?:ありません|無い|ない|見つかりませんでした)|ほかに[^。]{0,12}(?:ありません|無い|ない)|"
                        r"脆弱性は(?:ありません|無い|ない)|安全です|"
                        r"\bno (?:other )?(?:issues|problems|vulnerabilities)\b)", re.I)


def split_clauses(text):
    parts = re.split(r"[。．！？!?\n、,;；]|\.(?:\s|$)|\band\b|\bthen\b", text)
    return [p.strip() for p in parts if p and p.strip()]


def decompose(text):
    """申告を claim に分ける。規則による分解で、意味は読まない。

    ひとつの節から複数の claim が出てもよい（「テストが通ることを確認」は
    実行と成功の両方を言っている）。同じ種類は1つにまとめ、根拠の節を並べる。"""
    found = {}

    def add(kind, clause, files=()):
        c = found.setdefault(kind, {"kind": kind, "text": CLAIM_KINDS[kind],
                                    "quotes": [], "files": []})
        if clause not in c["quotes"]:
            c["quotes"].append(clause)
        for f in files:
            if f not in c["files"]:
                c["files"].append(f)

    last_was_test = False
    for sentence in re.split(r"(?<=[。！？!?])\s*|\n+", text):
      prev_external = False
      for clause in split_clauses(sentence):
        files = [f for f in RE_FILE.findall(clause) if not f.startswith(".")]
        about_test = bool(RE_TEST.search(clause))
        # 作業場の外の話か。同じ文で直前の節が外の話なら、ファイル名を持たない節もその続きと読む
        #   「本番 DB で実行して、id=42 のメールを更新しました」の後ろ半分
        external = bool(RE_EXTERNAL.search(clause)) or (prev_external and not files)
        prev_external = external
        if RE_ABSENCE.search(clause):
            add("absence", clause)
        elif external and not about_test and (RE_CHANGE.search(clause) or RE_RAN.search(clause)
                                              or RE_DONE.search(clause)
                                              or re.search(r"\b(?:deployed|sent|pushed|published|notified|posted|uploaded)\b", clause, re.I)):
            add("external", clause)
        elif RE_BUG.search(clause):
            add("bug_fixed", clause)
        elif not about_test and last_was_test and RE_PASS.search(clause):
            # 「テストを実行し、すべて通りました」の後ろ半分。主語はひとつ前の節にある
            add("tests_passed", clause)
            about_test = True
        elif about_test:
            if RE_PASS.search(clause):
                add("tests_passed", clause)
                if RE_RAN.search(clause) or re.search(r"確認|confirm|verif", clause, re.I):
                    add("ran_tests", clause)
            elif RE_RAN.search(clause):
                add("ran_tests", clause)
            elif RE_CHANGE.search(clause):
                add("changed_files", clause, files)
        elif RE_CHANGE.search(clause):
            add("changed_files", clause, files)
        elif RE_DONE.search(clause):
            add("other", clause)
        last_was_test = about_test
    order = list(CLAIM_KINDS)
    return sorted(found.values(), key=lambda c: order.index(c["kind"]))


# ── 受領証（guardrun）の取り込み口 ─────────────────────────

def load_receipt(path):
    """guardrun の受領証から、ここで使う事実だけを取り出す。

    2つの形を読む。
      guardrun の実物（受領証.json、または guardrun.py が最後に出す JSON）
        判定（緑・青・赤・失敗・中断・拒否）・終了コード・状態・差分（追加・削除・変更）・理由
        形式版2 なら 期待・事後.照合 も
      仮の形（実物に合わせる前の試験用）
        {"mark", "exit_code", "processes", "outside_changes"}
    無い欄は「その証拠は無い」として扱い、推測で埋めない。

    **受領証に、壁の中で走った1本1本の命令は無い。**「命令」はエージェント全体を
    起動した1本だけ。だから「テストを実行した」の証拠にはならない（processes は None）。
    そちらはハーネスの記録（--codex-jsonl）が担う。"""
    with open(path) as f:
        r = json.load(f)
    if "判定" not in r and "差分" not in r:
        return {"source": "guardrun の受領証（仮の形）",
                "processes": r.get("processes"), "outside_changes": r.get("outside_changes"),
                "mark": r.get("mark"), "exit_code": r.get("exit_code")}

    def paths(key):
        return sorted(x.get("path") if isinstance(x, dict) else str(x)
                      for x in ((r.get("差分") or {}).get(key) or []))

    mark = r.get("判定")
    state = r.get("状態")
    # **作業場の外は、測った数ではなく壁の保証として扱う。**
    #   壁の内側で最後まで見届けた走り（緑・青・赤・失敗）なら、作業場の外への
    #   書き込みは壁が断っている。中断・拒否は見届けていないので何も言わない。
    #   これは guardrun の保証境界（ロードマップ Phase 1）に乗った判定で、
    #   古いカーネルや Windows では境界が狭い。
    見届けた = mark in ("緑", "青", "赤", "失敗") and state in (None, "終了")
    return {
        "source": "guardrun の受領証",
        "processes": None,
        "outside_changes": 0 if 見届けた else None,
        "outside_basis": f"受領証の判定「{mark}」= 壁の内側で最後まで見届けた走り（外への書き込みは壁が断る）"
        if 見届けた else None,
        "mark": mark,
        "state": state,
        "exit_code": r.get("終了コード"),
        "workspace": r.get("作業場"),
        "reasons": r.get("理由") or [],
        "receipt_diff": {"added": paths("追加"), "removed": paths("削除"), "changed": paths("変更")}
        if "差分" in r else None,
        "version": r.get("形式版"),
        "expected": r.get("期待"),
        "expect_check": (r.get("事後") or {}).get("照合"),
    }


# ── ハーネスの記録（codex exec --json の形）の取り込み口 ─────────

def load_codex_events(path):
    """`codex exec --json` が出す JSONL から、走った命令と最後の発言を取り出す。

    形は openai/codex の codex-rs/exec/src/exec_events.rs に従う。
    qwc も `qwc -p ... --events FILE` で同じ形を書くので、どちらの記録も読める。

    これはハーネス（Codex や qwc）が自分で見た事実で、モデルの文よりは強いが、
    カーネルの記録ほど強くはない。作業場の中に置かれた記録はモデルが書き換えられるので、
    記録は作業場の外に書かせること。作業場の外の変化はここからは分からない。"""
    commands, agent_text, failed = [], None, False
    with open(path) as f:
        for row in f:
            row = row.strip()
            if not row:
                continue
            try:
                ev = json.loads(row)
            except ValueError:
                continue
            if ev.get("type") in ("turn.failed", "error"):
                failed = True
            if ev.get("type") != "item.completed":
                continue
            it = ev.get("item") or {}
            if it.get("type") == "command_execution" and it.get("status") != "declined":
                commands.append({"command": str(it.get("command", "")),
                                 "exit_code": it.get("exit_code"), "status": it.get("status")})
            elif it.get("type") == "agent_message":
                agent_text = it.get("text", "")
    return {"source": "ハーネスの記録（codex exec --json の形）",
            "processes": [split_command(cm["command"]) for cm in commands],
            "commands": commands, "outside_changes": None,
            "agent_message": agent_text, "turn_failed": failed}


def split_command(command):
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def merge_evidence(receipt, harness):
    """受領証（カーネル側）を優先し、無い項目だけハーネスの記録で埋める。"""
    if not receipt:
        return harness
    if not harness:
        return receipt
    out = dict(harness)
    for k, v in receipt.items():
        if v is not None:
            out[k] = v
    out["source"] = receipt["source"] if receipt.get("processes") is not None else harness["source"]
    return out


# ── NVIDIA OpenShell の監査記録（OCSF）の取り込み口 ─────────────────
#
# OpenShell（github.com/NVIDIA/OpenShell）は、砂場の中の監督プロセスが OCSF v1.8 の
# JSONL を /var/log/openshell-ocsf.YYYY-MM-DD.log に書く（ocsf_json_enabled を true に）。
# 調べた範囲（2026-10-01・main 021400b）で、ここから取れるもの／取れないもの:
#   取れる   Process Activity 1007   エージェント全体（ワークロード）の起動・終了・時間切れ
#            Network / HTTP 4001・4002 外への接続の許可・拒否
#            Detection Finding 2004  方針の回り込みなどの検知
#            Config 5019             「Landlock ruleset built [rules_applied:N skipped:M]」
#   取れない 中で走った1本1本の命令、ファイルの変化（File System Activity は出さない）
# だから「テストを実行した」はハーネスの記録、「何が変わったか」は封印からの差分が担う。
#
# **既定の landlock.compatibility は best_effort で、Landlock が掛からなければ
# ファイルの制限なしで走る**（記録に「Running WITHOUT filesystem restrictions」が残るだけ）。
# 作業場の外を壁の保証として PROVEN にするのは、Landlock が掛かった記録があり、掛からなかった
# 記録が無く、方針の read_write が作業場の中だけのときに限る。

LANDLOCK_OK = re.compile(r"Landlock ruleset built \[rules_applied:(\d+) skipped:(\d+)\]")
LANDLOCK_NG = re.compile(r"WITHOUT filesystem restrictions|restrict_self failed|zero valid paths|"
                         r"Landlock unavailable", re.I)


def load_ocsf(path):
    landlock_ok, landlock_ng, denials, findings, workload = [], [], [], [], {}
    seen_openshell = False
    with open(path) as f:
        for row in f:
            row = row.strip()
            if not row:
                continue
            try:
                e = json.loads(row)
            except ValueError:
                continue
            product = ((e.get("metadata") or {}).get("product") or {}).get("name", "")
            if "OpenShell" in product:
                seen_openshell = True
            msg = str(e.get("message") or "")
            cls = e.get("class_uid")
            if LANDLOCK_OK.search(msg):
                landlock_ok.append(msg)
            if LANDLOCK_NG.search(msg) or LANDLOCK_NG.search(str(e.get("status_detail") or "")):
                landlock_ng.append(msg)
            if cls in (4001, 4002) and str(e.get("action", "")).lower() == "denied":
                denials.append(msg or str(e.get("dst_endpoint")))
            if cls == 2004 and int(e.get("severity_id") or 0) >= 4:   # High 以上
                findings.append(msg)
            if cls == 1007:
                if e.get("exit_code") is not None:
                    workload["exit_code"] = e["exit_code"]
                if re.search(r"time(?:d)? ?out", msg, re.I):
                    workload["timed_out"] = True
    return {"source": "OpenShell の監査記録（OCSF）", "seen_openshell": seen_openshell,
            "landlock_ok": landlock_ok, "landlock_ng": landlock_ng,
            "denials": denials, "findings": findings, "workload": workload}


def load_openshell_policy(path):
    """方針の YAML から filesystem_policy だけを読む（PyYAML に頼らない最小の読み方）。

    読むのは include_workdir と read_write（[a, b] の形と「- a」の形）。分からない書き方なら
    None を返し、作業場の外については何も言わない。"""
    try:
        text = open(path).read()
    except OSError:
        return None
    m = re.search(r"^filesystem_policy:\s*\n((?:[ \t]+.*\n?)*)", text, re.M)
    if not m:
        # filesystem_policy が無ければ、OpenShell の既定は include_workdir: true で read_write は空
        return {"include_workdir": True, "read_write": [], "explicit": False}
    body = m.group(1)
    inc = re.search(r"include_workdir:\s*(true|false)", body)
    rw = []
    flow = re.search(r"read_write:\s*\[([^\]]*)\]", body)
    if flow:
        rw = [x.strip().strip("'\"") for x in flow.group(1).split(",") if x.strip()]
    else:
        block = re.search(r"read_write:\s*\n((?:[ \t]+-\s*.*\n?)*)", body)
        if block:
            rw = [x.strip().lstrip("-").strip().strip("'\"") for x in block.group(1).splitlines() if x.strip()]
        elif re.search(r"read_write:", body):
            return None
    return {"include_workdir": (inc.group(1) == "true") if inc else False, "read_write": rw, "explicit": True}


def judge_openshell(o, policy, workspace):
    """OpenShell の記録から言える契約の行。強さはカーネル（壁の外の監督プロセスの記録）。"""
    out = []
    ev_wall = [f"Landlock が掛かった: {o['landlock_ok'][-1]}"] if o["landlock_ok"] else []
    ev_wall += [f"外への接続を拒んだ: {len(o['denials'])} 件"] if o["denials"] else []
    if o["landlock_ng"]:
        out.append(item("openshell_wall", "OpenShell の壁（Landlock）が掛かっていた", DISPROVEN, DETERMINISTIC,
                        [f"掛からなかった記録: {o['landlock_ng'][0]}"] + ev_wall))
    elif o["findings"]:
        out.append(item("openshell_wall", "OpenShell の壁（Landlock）が掛かっていた", DISPROVEN, DETERMINISTIC,
                        [f"重大な検知: {x}" for x in o["findings"][:3]] + ev_wall))
    elif o["landlock_ok"]:
        out.append(item("openshell_wall", "OpenShell の壁（Landlock）が掛かっていた", PROVEN, DETERMINISTIC, ev_wall))
    else:
        out.append(item("openshell_wall", "OpenShell の壁（Landlock）が掛かっていた", UNVERIFIED, DETERMINISTIC, ev_wall,
                        # 2026-10-01、OpenShell main（fde79f1）を docker で動かして確かめた: 今の版は
                        # この記録を OCSF の JSONL に出さない（壁はテキストのログに「Isolation boundary
                        # enforcement confirmed」と出るだけ）。それを Landlock が掛かった証拠には読まない
                        # ——best_effort では「確かめた」の中身が Landlock かどうか、記録からは分からない
                        ["「Landlock ruleset built」の記録（ocsf_json_enabled を true にした砂場の記録）。"
                         "OpenShell main（fde79f1）はこれを JSONL に出さないので、その版では壁は UNVERIFIED のまま"]))
    return out


def openshell_outside(o, policy, workspace):
    """作業場の外を壁の保証として言えるか。言えれば根拠の文を、言えなければ None と理由を返す。"""
    if not o or o["landlock_ng"] or not o["landlock_ok"]:
        return None, "OpenShell の記録で Landlock が掛かったと確かめられない"
    if policy is None:
        return None, "OpenShell の方針（--openshell-policy）。書ける場所が作業場の中だけかを確かめるため"
    ws = os.path.realpath(workspace)
    outside = [p for p in policy["read_write"]
               if not (os.path.realpath(p) == ws or os.path.realpath(p).startswith(ws + os.sep))]
    if outside:
        return None, f"OpenShell の方針が作業場の外への書き込みを許している: {', '.join(outside)}"
    return ("OpenShell: Landlock が掛かり、方針の read_write は作業場の中だけ"
            "（ほかの場所への書き込みはカーネルが断る。ネットワーク規則があると既定の場所が足される点に注意）"), None

# ── 判定 ────────────────────────────────────────────────

def item(ident, text, verdict, basis, evidence=(), missing=()):
    return {"id": ident, "text": text, "verdict": verdict, "basis": basis,
            "evidence": list(evidence), "missing": list(missing)}


def overall(items):
    vs = [i["verdict"] for i in items]
    if DISPROVEN in vs:
        return DISPROVEN
    if UNVERIFIED in vs or not vs:
        return UNVERIFIED
    return PROVEN


def judge_contract(c, d, final_runs, base_runs, receipt):
    out = []
    ch = touched(d)

    if final_runs is None:
        # --fast で再実行を打ち切った。テストの行は判定しない（PROVEN にも DISPROVEN にもしない）
        stopped = "テストの再実行を打ち切った（--fast：先に安い証拠で DISPROVEN が出た）"
        for key, label in (("repro", "再現テストが修正後に通る"), ("must_pass", "通る"), ("keep_passing", "今も通る")):
            for i, cmd in enumerate(c.get(key, [])):
                out.append(item(f"{key}[{i}]", f"{label}: {cmd}", UNVERIFIED, DETERMINISTIC, [], [stopped]))

    for i, cmd in enumerate(c.get("repro", []) if final_runs is not None else []):
        f, b = final_runs[cmd], base_runs[cmd]
        ev = [f"修正前: {desc(b)}", f"修正後: {desc(f)}"]
        if not passed(f):
            out.append(item(f"repro[{i}]", f"再現テストが修正後に通る: {cmd}",
                            DISPROVEN, DETERMINISTIC, ev))
        elif passed(b):
            out.append(item(f"repro[{i}]", f"再現テストが修正後に通る: {cmd}",
                            UNVERIFIED, DETERMINISTIC, ev,
                            ["修正前に落ちる再現テスト（これは修正前にも通るので再現になっていない）"]))
        else:
            out.append(item(f"repro[{i}]", f"再現テストが修正後に通る: {cmd}",
                            PROVEN, DETERMINISTIC, ev))

    for i, cmd in enumerate(c.get("must_pass", []) if final_runs is not None else []):
        f = final_runs[cmd]
        out.append(item(f"must_pass[{i}]", f"通る: {cmd}",
                        PROVEN if passed(f) else DISPROVEN, DETERMINISTIC, [desc(f)]))

    for i, cmd in enumerate(c.get("keep_passing", []) if final_runs is not None else []):
        f, b = final_runs[cmd], base_runs[cmd]
        ev = [f"修正前: {desc(b)}", f"修正後: {desc(f)}"]
        if not passed(f):
            v = DISPROVEN
        elif not passed(b):
            # もともと落ちていたものは regression の物差しにならない
            out.append(item(f"keep_passing[{i}]", f"今も通る: {cmd}", UNVERIFIED,
                            DETERMINISTIC, ev, ["修正前に通っていた regression テスト"]))
            continue
        else:
            v = PROVEN
        out.append(item(f"keep_passing[{i}]", f"今も通る: {cmd}", v, DETERMINISTIC, ev))

    outside = [p for p in ch if not matches(p, c["may_change"])]
    out.append(item("may_change", "変えたのは may_change の中だけ"
                    + (f"（{', '.join(c['may_change'])}）" if c["may_change"] else "（どこも変えない）"),
                    DISPROVEN if outside else PROVEN, DETERMINISTIC,
                    [f"外で変わった: {', '.join(outside)}"] if outside
                    else [f"変わった {len(ch)} 件はすべて許された場所"]))

    if c["must_not_change"]:
        hit = [p for p in ch if matches(p, c["must_not_change"])]
        out.append(item("must_not_change", f"変えていない: {', '.join(c['must_not_change'])}",
                        DISPROVEN if hit else PROVEN, DETERMINISTIC,
                        [f"変わった: {', '.join(hit)}"] if hit else ["該当の変更なし"]))

    hooks = [p for p in ch if matches(p, TEST_HOOKS) and not matches(p, c["may_change"])]
    out.append(item("test_hooks", "試験の結果を変えるフックを置いていない（sitecustomize.py・conftest.py など）",
                    DISPROVEN if hooks else PROVEN, DETERMINISTIC,
                    [f"置いた・変えた: {', '.join(hooks)}"] if hooks else ["該当の変更なし"]))

    oc = receipt.get("outside_changes") if receipt else None
    os_basis, os_missing = (None, None)
    if receipt and receipt.get("openshell") is not None:
        os_basis, os_missing = openshell_outside(receipt["openshell"], receipt.get("openshell_policy"),
                                                 receipt.get("seal_workspace", ""))
        if oc is None and os_basis:
            oc = 0
            receipt["outside_basis"] = os_basis
    if oc is None and os_missing:
        out.append(item("outside", "作業場の外を変えていない", UNVERIFIED, DETERMINISTIC, [], [os_missing]))
    elif oc is None:
        why = ["作業場の外の変化の記録（guardrun の受領証）"]
        if receipt and receipt.get("mark") in ("中断", "拒否"):
            why = [f"受領証の判定が「{receipt['mark']}」で、壁の中で最後まで見届けていない"]
        out.append(item("outside", "作業場の外を変えていない", UNVERIFIED, DETERMINISTIC, [], why))
    else:
        out.append(item("outside", "作業場の外を変えていない",
                        PROVEN if oc == 0 else DISPROVEN, DETERMINISTIC,
                        [receipt.get("outside_basis") or f"受領証: 作業場の外で変わった数 {oc}"]))

    if receipt and receipt.get("openshell") is not None:
        out.extend(judge_openshell(receipt["openshell"], receipt.get("openshell_policy"),
                                   receipt.get("seal_workspace", "")))
    if receipt and receipt.get("mark"):
        out.append(judge_mark(receipt))
    if receipt and receipt.get("receipt_diff") is not None:
        out.append(judge_two_diffs(receipt["receipt_diff"], d, c))
    return out


def judge_mark(receipt):
    """guardrun の印。緑・青は見届けた走り、赤は壊した・縮めた・仕掛けを置いた。"""
    mark = receipt["mark"]
    ev = [f"受領証の判定: {mark}"] + [f"理由: {x}" for x in receipt.get("reasons", [])[:3]]
    if mark in ("緑", "青"):
        return item("guardrun_mark", "guardrun の印が赤・中断・拒否でない", PROVEN, DETERMINISTIC, ev)
    if mark == "赤":
        return item("guardrun_mark", "guardrun の印が赤・中断・拒否でない", DISPROVEN, DETERMINISTIC, ev)
    if mark == "失敗":
        return item("guardrun_mark", "guardrun の印が赤・中断・拒否でない", UNVERIFIED, DETERMINISTIC, ev,
                    ["エージェントが 0 以外で終わった。仕事が終わったかは契約のテストで見る"])
    return item("guardrun_mark", "guardrun の印が赤・中断・拒否でない", UNVERIFIED, DETERMINISTIC, ev,
                [f"判定「{mark}」は走りを最後まで見届けていない"])


def judge_two_diffs(rd, d, c):
    """**同じ差分に二通りの道で着く。**受領証（guardrun の採点）と proofcheck の封印。

    片方が間違っていれば、ここで食い違いが表に出る。共通化しない（評価層の
    神託と見張りを別実装にしてあるのと同じ理由）。どちらが正しいかはここでは決めない。"""
    ignore = DEFAULT_IGNORE + c["ignore"]
    theirs = {k: sorted(p for p in rd[k] if not matches(p, ignore)) for k in ("added", "removed", "changed")}
    ours = {k: sorted(d[k]) for k in ("added", "removed", "changed")}
    if theirs == ours:
        return item("two_diffs", "受領証の差分と封印からの差分が一致する", PROVEN, DETERMINISTIC,
                    [f"どちらも 追加 {len(ours['added'])}・削除 {len(ours['removed'])}・変更 {len(ours['changed'])}"])
    ev = []
    for k, name in (("added", "追加"), ("removed", "削除"), ("changed", "変更")):
        only_r = sorted(set(theirs[k]) - set(ours[k]))
        only_p = sorted(set(ours[k]) - set(theirs[k]))
        if only_r:
            ev.append(f"{name}: 受領証にだけある {', '.join(only_r)}")
        if only_p:
            ev.append(f"{name}: 封印からの差分にだけある {', '.join(only_p)}")
    return item("two_diffs", "受領証の差分と封印からの差分が一致する", DISPROVEN, DETERMINISTIC, ev)


# ── 判定の核（定式化。verify/定式化.md） ─────────────────────────
#
# 証拠 e = (種類, 向き, 強さ, 出どころ, 中身)
#   向き   "+" 裏づける / "-" 矛盾する / "?" 判断に使えない（理由だけ残す）
#   強さ   改竄されにくさ。カーネル ＞ 検証器 ＞ ハーネス
# 主張の種類 k ごとに、PROVEN に要る証拠の種類 R(k) と、その最低限の強さ m を決めておく。
# decide(k, E) は E の並びによらず、同じ入力に同じ答えを返す純粋な関数。

KERNEL, VERIFIER, HARNESS = 3, 2, 1
STRENGTH_NAME = {KERNEL: "カーネル（guardrun の受領証）", VERIFIER: "検証器（proofcheck が自分で取った事実）",
                 HARNESS: "ハーネス（エージェント側のプロセスの記録）"}

# 証拠の種類: (最低限の強さ, 足りないときに書くこと)
EVIDENCE_KINDS = {
    "fs_change": (VERIFIER, "封印からの作業場の差分"),
    "test_process": (HARNESS, "エージェントが走らせた命令の記録（guardrun の受領証か、ハーネスの記録）"),
    "test_result": (VERIFIER, "契約のテスト"),
    "repro_flip": (VERIFIER, "再現テスト（修正前に落ち、修正後に通るもの）を契約の repro に"),
    # この2つは、この層では取りにいく手段が無い。足りない証拠として名前だけを持つ（Phase 8 の入口）
    "external_state": (KERNEL, "作業場の外の状態を読み取り専用で確かめた記録（本番・DB・外部サービス）"),
    "absence_proof": (KERNEL, "無いことの証明（機械では決まらない。人の確認か、網羅的な検査）"),
}

# 主張の種類: (要る証拠の種類, 意味の判断を含むか)
# other は要る証拠が定義されていないので、どんな証拠があっても PROVEN にならない。
CLAIM_REQUIREMENTS = {
    "changed_files": (("fs_change",), False),
    "ran_tests": (("test_process",), False),
    "tests_passed": (("test_result",), False),
    "bug_fixed": (("repro_flip",), True),
    "external": (("external_state",), True),
    "absence": (("absence_proof",), True),
    "other": ((), True),
}


def ev(kind, stance, strength, source, detail):
    return {"kind": kind, "stance": stance, "strength": strength, "source": source, "detail": detail}


def decide(claim_kind, evidence):
    """主張1つを三値で決める。

    返り: {"verdict", "basis", "trust", "used", "missing", "conflict"}
      trust … 判定に使った証拠のうち一番弱いものの強さ（どこから不確かさが入ったか）
    規則（定式化.md の D1〜D4）:
      D1 強さが足りる「-」と「+」が同じ主張に両方ある → UNVERIFIED（証拠どうしの食い違い）
      D2 強さが足りる「-」がある                         → DISPROVEN
      D3 要る種類が全部、強さが足りる「+」で埋まる       → PROVEN
      D4 それ以外                                        → UNVERIFIED（足りない種類を書く）"""
    required, semantic = CLAIM_REQUIREMENTS.get(claim_kind, ((), True))
    basis = SEMANTIC if semantic else DETERMINISTIC
    admissible = [e for e in evidence
                  if e["kind"] in required and e["stance"] in "+-"
                  and e["strength"] >= EVIDENCE_KINDS[e["kind"]][0]]
    contra = [e for e in admissible if e["stance"] == "-"]
    support = [e for e in admissible if e["stance"] == "+"]
    out = {"basis": basis, "used": [], "missing": [], "conflict": False, "trust": None}
    if contra and support:
        out.update(verdict=UNVERIFIED, conflict=True, used=contra + support,
                   missing=["証拠どうしが食い違っている（どちらかの記録が壊れているか、書き換えられている）"])
    elif contra:
        out.update(verdict=DISPROVEN, used=contra)
    elif required and all(any(e["kind"] == k for e in support) for k in required):
        out.update(verdict=PROVEN, used=support)
    else:
        lacking = [k for k in required if not any(e["kind"] == k for e in support)]
        # 足りない種類ごとに、取れなかった理由（向き「?」の証拠）を添える。
        # **並びに依存させない**ので、理由は集合にして並べ直す（性質 P3。乱数の試験で一度破れた）
        def 説明(k):
            why = sorted({e["detail"] for e in evidence if e["kind"] == k and e["stance"] == "?"})
            return EVIDENCE_KINDS[k][1] + (f"（{'／'.join(why)}）" if why else "")
        out.update(verdict=UNVERIFIED,
                   missing=[説明(k) for k in lacking] if required
                   else ["この種類の申告に対応する証拠の定義"])
    if out["used"]:
        out["trust"] = min(e["strength"] for e in out["used"])
    return out


def claim_evidence(cl, c, d, final_runs, base_runs, receipt):
    """主張1つに、いま手元にある証拠を集める。判断はしない（decide に任せる）。

    final_runs / base_runs が None のときは、テストの再実行をしていない（--fast で打ち切った）。"""
    out = []
    ch = touched(d)
    test_cmds = c.get("repro", []) + c.get("must_pass", []) + c.get("keep_passing", [])
    k = cl["kind"]
    if k == "changed_files":
        named = cl["files"]
        if named:
            miss = [f for f in named if not any(p == f or p.endswith("/" + f) for p in ch)]
            out.append(ev("fs_change", "-" if miss else "+", VERIFIER, "封印からの差分",
                          f"名指しされたのに変わっていない: {', '.join(miss)}" if miss
                          else f"名指しされた {', '.join(named)} は変わっている"))
        else:
            out.append(ev("fs_change", "+" if ch else "-", VERIFIER, "封印からの差分",
                          f"作業場で {len(ch)} 件変わった" if ch else "作業場は封印時から1バイトも変わっていない"))
    elif k == "ran_tests":
        procs = receipt.get("processes") if receipt else None
        if procs is not None:
            hit = [p for p in procs if looks_like_test(p, test_cmds)]
            strength = KERNEL if "受領証" in receipt.get("source", "") and "仮" not in receipt.get("source", "") else HARNESS
            out.append(ev("test_process", "+" if hit else "-", strength, receipt["source"],
                          f"{receipt['source']}: 命令 {len(procs)} 本のうちテストらしきもの {len(hit)} 本"))
    elif k == "tests_passed":
        if test_cmds and final_runs is not None:
            fails = [cmd for cmd in test_cmds if not passed(final_runs[cmd])]
            out.append(ev("test_result", "-" if fails else "+", VERIFIER, "proofcheck の再実行",
                          "テストとフックを元に戻して proofcheck が走らせた: "
                          + ("; ".join(f"{cmd} → {desc(final_runs[cmd])}" for cmd in fails)
                             if fails else f"{len(test_cmds)} 本とも通った")))
        elif test_cmds:
            out.append(ev("test_result", "?", VERIFIER, "proofcheck",
                          "テストの再実行を打ち切った（--fast：先に安い証拠で DISPROVEN が出た）"))
        # エージェント自身の最後のテスト実行。強さはハーネスなので判定には効かないが、食い違いを見せる
        own = [cm for cm in (receipt or {}).get("commands") or []
               if looks_like_test(split_command(cm["command"]), test_cmds)]
        if own:
            last = own[-1]
            out.append(ev("test_result", "+" if last["exit_code"] == 0 else "-", HARNESS, receipt["source"],
                          f"{receipt['source']}: エージェントの最後のテスト実行 `{last['command']}` → "
                          f"終了コード {last['exit_code']}"))
    elif k == "bug_fixed":
        repro = c.get("repro", [])
        if repro and final_runs is not None:
            bad = [cmd for cmd in repro if not passed(final_runs[cmd])]
            weak = [cmd for cmd in repro if passed(base_runs[cmd])]
            if bad:
                out.append(ev("repro_flip", "-", VERIFIER, "proofcheck の再実行",
                              f"再現テストが修正後も落ちる: {', '.join(bad)}"))
            elif weak:
                out.append(ev("repro_flip", "?", VERIFIER, "proofcheck の再実行",
                              f"修正前にも通る再現テスト: {', '.join(weak)}"))
            else:
                out.append(ev("repro_flip", "+", VERIFIER, "proofcheck の再実行",
                              f"再現テスト {len(repro)} 本が修正前に落ち、修正後に通る"
                              "（「直った」の意味は再現テストに委ねている）"))
        elif repro:
            out.append(ev("repro_flip", "?", VERIFIER, "proofcheck",
                          "テストの再実行を打ち切った（--fast：先に安い証拠で DISPROVEN が出た）"))
    return out


def judge_claims(claims, c, d, final_runs, base_runs, receipt):
    out = []
    for n, cl in enumerate(claims, 1):
        evidence = claim_evidence(cl, c, d, final_runs, base_runs, receipt)
        r = decide(cl["kind"], evidence)
        shown = [e["detail"] if e in r["used"] or e["stance"] == "?" else f"（参考・判定に使わない強さ）{e['detail']}"
                 for e in evidence if e["stance"] != "?" or r["verdict"] != UNVERIFIED]
        it = item(f"claim{n}", f"{cl['text']}（「{' / '.join(cl['quotes'])}」）",
                  r["verdict"], r["basis"], shown, r["missing"])
        it["trust"] = STRENGTH_NAME.get(r["trust"])
        if r["conflict"]:
            it["conflict"] = True
        out.append(it)
    return out


# 再実行が要る主張の種類（--fast で後回しにするもの）
NEEDS_RUNS = {"tests_passed", "bug_fixed"}


def looks_like_test(argv, test_cmds):
    """受領証の命令が、テストを走らせたものに見えるか。

    契約のコマンドとは、プログラムの場所（/usr/bin/python3 と python3）を問わず、
    引数が同じなら同じと見なす。"""
    args = list(argv[1:])
    joined = " ".join(argv)
    for cmd in test_cmds:
        # Codex は命令を `bash -lc '…'` で包むことがある。包まれた中身でも当てる
        if " ".join(shlex.split(cmd)) in joined:
            return True
        want = shlex.split(cmd)
        if want and os.path.basename(want[0]) == os.path.basename(argv[0] if argv else "") \
                and want[1:] == args:
            return True
    return bool(re.search(r"\b(pytest|unittest|jest|vitest|mocha|npm (run )?test|go test|cargo test)\b"
                          r"|(^|[\s/])test[_\w]*\.(py|js|mjs|ts)\b", joined))


def desc(r):
    if r["timeout"]:
        return "時間切れ"
    if r["exit"] is None:
        return r["tail"] or "起動できない"
    return "通った（終了コード 0）" if r["exit"] == 0 else f"落ちた（終了コード {r['exit']}）"


