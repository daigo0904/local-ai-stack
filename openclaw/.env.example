# ~/.openclaw/.env のひな形。実物はここには入っていない（.gitignore で外してある）。
#
# 値のところに書いてあるのは「何を入れるか」の説明。
# そのままコピーして ~/.openclaw/.env にし、右辺を本物に書き換えて使う。

# OpenClaw のゲートウェイに接続するための合言葉。自分で決めた任意の文字列でよい。
OPENCLAW_GATEWAY_TOKEN=any secret string you choose please

# ollama を鍵付きで動かしているときだけ要る。ふつうは空でよい。
OLLAMA_API_KEY=ollama api key please (leave empty if not used)

# ウェブ検索。tavily.com で取る。無料枠あり。
TAVILY_API_KEY=tavily api key please

# Discord の Bot トークン。Discord Developer Portal → Bot → Reset Token で取る。
DISCORD_BOT_TOKEN=discord bot token please

# 見張りの知らせを流すチャンネルのID。Discord で「IDをコピー」から取る。
DISCORD_CHANNEL_ID=discord channel id please

# LINE。公式アカウント管理画面 → Messaging API から取る。
LINE_CHANNEL_SECRET=line channel secret please
LINE_CHANNEL_ACCESS_TOKEN=line channel access token please

# Bluesky に投稿するときだけ。アプリパスワードは設定→アプリパスワードで作る。
BSKY_HANDLE=your handle please (example: someone.bsky.social)
BSKY_APP_PASSWORD=bluesky app password please
