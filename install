#!/usr/bin/env python3
"""
install — この一式を Mac に入れる。

    ./install            全部入れる
    ./install --check    何が入っているか見る
    ./install guards     一部だけ入れる（guards / openclaw / tools / qwc / verify）

入るもの:
  qwc       本体（daigo0904/qwythos-code）を ~/コーディングCLI に git clone し、
            ~/bin/qwc から呼べるようにする。もうあれば触らない
  guards    見張り4つ＋claw を ~/bin に置き、launchd に登録する
  openclaw  設定のひな形を ~/.openclaw に置く（鍵は自分で埋める）
  tools     日々の道具22本を ~/bin に置く
  verify    proofcheck（申告を実行の証拠と突き合わせる）と agent-run を ~/bin に置く

先に入れておくもの:
  - ollama（頭脳）        brew install ollama && ollama pull gemma4:26b
  - OpenClaw（受け口）    npm i -g openclaw
  どちらも別プロジェクト。この一式はその上に載る。
"""

import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, "bin")

PARTS = ["qwc", "guards", "openclaw", "tools", "verify"]


def run_child(part):
    """guards と openclaw は自分の install を持っている。そちらに任せる。

    親がまとめて面倒を見ないのは、それぞれ単独でも入れられるようにしておくため。
    片方だけ使いたい人に、要らないほうまで入れさせない。"""
    child = os.path.join(HERE, part, "install")
    if not os.path.exists(child):
        return False
    print(f"\n── {part} ──")
    subprocess.run([sys.executable, child])
    return True


def install_tools():
    print("\n── tools ──")
    os.makedirs(BIN, exist_ok=True)
    src_dir = os.path.join(HERE, "tools")
    n = 0
    for fn in sorted(os.listdir(src_dir)):
        src = os.path.join(src_dir, fn)
        if not os.path.isfile(src):
            continue
        dst = os.path.join(BIN, fn)
        shutil.copy2(src, dst)
        os.chmod(dst, 0o755)
        n += 1
    print(f"  {n} 本を {BIN} に置いた")


def install_verify():
    print("\n── verify ──")
    os.makedirs(BIN, exist_ok=True)
    for name in ("proofcheck", "agent-run"):
        dst = os.path.join(BIN, name)
        shutil.copy2(os.path.join(HERE, "verify", name), dst)
        os.chmod(dst, 0o755)
        print(f"  置いた  {dst}")


# qwc の本体。この一式には写しを持たない。
# 写しを持っていた頃は、本体が24コミット先へ進んでも写しは古いまま残り、
# 写しにだけ足した機能（--events）が本体に無い、というずれが実際に起きた。
QWC_REPO = os.environ.get("QWC_REPO", "https://github.com/daigo0904/qwythos-code")


def install_qwc():
    print("\n── qwc ──")
    dst = os.path.join(HOME, "コーディングCLI")
    if os.path.exists(dst):
        # 作業中の変更があるかもしれないので、入れ直しでも触らない
        if os.path.isdir(os.path.join(dst, ".git")):
            print(f"  すでにある（触らない）  {dst}")
            print(f"    新しくするなら: git -C {dst} pull --ff-only")
        else:
            print(f"  すでにあるが、git で取ってきたものではない  {dst}")
            print("    前の一式が置いた写しかもしれない。本体に替えるなら、退避してから入れ直す:")
            print(f"      mv {dst} {dst}.old && ./install qwc")
    else:
        # 取ってこられないときに git がパスワードを聞いて止まらないようにする
        env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
        r = subprocess.run(["git", "clone", QWC_REPO, dst], capture_output=True, text=True,
                           env=env, stdin=subprocess.DEVNULL)
        if r.returncode != 0:
            print(f"  取ってこられなかった  {QWC_REPO}")
            print("    " + (r.stderr.strip().splitlines() or ["(理由が出ていない)"])[-1])
            return
        print(f"  取ってきた  {QWC_REPO} → {dst}")
    if not os.path.exists(os.path.join(dst, "bin", "qwc.mjs")):
        print(f"  {dst}/bin/qwc.mjs が無いので、つながない")
        return
    os.makedirs(BIN, exist_ok=True)
    link = os.path.join(BIN, "qwc")
    target = os.path.join(dst, "bin", "qwc.mjs")
    if os.path.islink(link) or os.path.exists(link):
        os.remove(link)
    os.symlink(target, link)
    os.chmod(target, 0o755)
    print(f"  つないだ  {link} → {target}")


def check():
    print("入っているもの:")
    print(f"  {'●' if os.path.exists(os.path.join(BIN,'qwc')) else '○'} qwc")
    out = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    for label in ["ai.openclaw.model-guard", "ai.openclaw.watchdog", "ai.openclaw.line-guard",
                  "ai.openclaw.qwc-guard"]:
        print(f"  {'●' if label in out else '○'} {label}")
    print(f"  {'●' if os.path.exists(os.path.join(HOME,'.openclaw','openclaw.json')) else '○'} openclaw.json")
    n = len([f for f in os.listdir(os.path.join(HERE, "tools"))
             if os.path.exists(os.path.join(BIN, f))])
    print(f"  {'●' if n else '○'} tools（{n} 本）")
    print(f"  {'●' if os.path.exists(os.path.join(BIN,'proofcheck')) else '○'} proofcheck")
    print("\n  中身まで見るなら: claw status")


if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if "--check" in sys.argv[1:]:
        check()
        sys.exit(0)
    want = args or PARTS
    for part in want:
        if part == "tools":
            install_tools()
        elif part == "qwc":
            install_qwc()
        elif part == "verify":
            install_verify()
        else:
            run_child(part)
    print()
    check()
