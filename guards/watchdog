#!/usr/bin/env python3
"""
watchdog — 見張りたちと本体が「黙っていないか」を見る。

5分おきに走らせる前提。普段は何もせず、何もしなかったことも報告しない。
直したときと、直せなかったときだけ Discord に一言送る。

    watchdog              点検して、必要なら直す（普段は無言）
    watchdog --report     問題がなくても今の状態を表示する
    watchdog --dry-run    調べるだけで直さない
    watchdog --check      OK/NG だけ返す

見ているもの:
  1. model-guard が走り続けているか（心拍の新しさ）
  2. gateway が「立っているのに黙って」いないか
  3. 自分の心拍を残す（model-guard がこれを見て、こちらの死に気づく）

なぜ見張りの見張りが要るか:
  model-guard がひとつだけの砦になっている。それが黙ったら誰も気づかない。
  launchd は plist が読み込まれている限り繰り返し起動してくれるが、
  スクリプトが毎回落ちる・plist が外れる・設定を壊す、のどれでも
  「起動はしているのに一度も仕事をしていない」状態になる。
  だから「立ち上がったか」ではなく「走り切った跡」を見る。

なぜ相互監視で止めるか:
  見張りの見張りにも見張りが要る、で切りがない。
  1台のMacで打てる手は「2つが互いを見る」までで、そこから先
  （両方同時に黙る・Macごと落ちる）は外の機械にしか気づけない。
  できないことははっきり分けて、ここでは扱わない。

なぜ gateway をポートで見ないか:
  ポートは line-guard が見ていて、閉じていれば起こす。担当が重なると
  2つが同時に入れ直して傷を広げるので、こちらは見ない。
  こちらが見るのは「開いているのに答えない」ほうだけ。

なぜ openclaw を絶対パスで、PATH を足して呼ぶか:
  launchd が渡す PATH は /usr/bin:/bin:/usr/sbin:/sbin しかない。
  openclaw は /opt/homebrew/bin にあり、中身も `#!/usr/bin/env node` なので、
  そのまま呼ぶと `env: node: No such file or directory` で必ず失敗する。
  見張りが黙って無力になる典型なので、ここで潰しておく。
"""

import fcntl
import json
import os
import socket
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

# 見張りが共有する部品。同じものを4つに書き写していたが、
# 書き写した当日に編集で1つ壊し、説明文もずれていた。
# 独立を支えているのは別プロセス・別の時計・別の判断であって、
# 同じ文字列を別々に持つことではない。
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from guardlib import Guard, env_value, pulse_age, kickstart  # noqa: E402

G = Guard("watchdog")


ENV_FILE = os.path.expanduser("~/.openclaw/.env")
PLIST_DIR = os.path.expanduser("~/Library/LaunchAgents")

OPENCLAW = "/opt/homebrew/bin/openclaw"
BREW_BIN = "/opt/homebrew/bin"
GATEWAY_PORT = 18789
GATEWAY_LABEL = "ai.openclaw.gateway"
MODEL_GUARD_LABEL = "ai.openclaw.model-guard"
LINE_GUARD_LABEL = "ai.openclaw.line-guard"
QWC_GUARD_LABEL = "ai.openclaw.qwc-guard"

HEALTH_TIMEOUT = 30
# model-guard は2分おき。点検そのものに最大90秒かかるので、3回ぶん見送っても
# まだ余裕がある長さにする。短くすると、ollama が重い日に誤って蹴ってしまう。
MODEL_GUARD_STALE = 400
# line-guard は5分おき。トンネルを張り直す回は数分かかるので、3回ぶん見ておく。
LINE_GUARD_STALE = 1100
# qwc-guard は1日1回。Mac が寝ていた日もあるので、丸一日半までは待つ。
QWC_GUARD_STALE = 30 * 3600

# gateway を入れ直すまでに、何回続けてダメだったら動くか。
# 3分おきに走るので、答えないなら6分、詰まっているだけなら9分待つ。
#
# 入れ直すと Discord と LINE の受け口がいったん落ちる。
# 一度の失敗で落とすと、直すつもりで切っていることになるので、必ず続けて見る。
SILENT_BEFORE_RESTART = 2
DEGRADED_BEFORE_RESTART = 3
# gateway が「落ちたまま」のときに、こちらが手を出すまでの回数。
#
# 本来これは line-guard の担当で、あちらは5分おきに起こしにいく。
# だから普通は3回も続かない。続くということは line-guard 自身が
# 黙っているということなので、そのときだけ肩代わりする。
# 担当を分けたままにすると「line-guard が死なない前提」の設計になってしまう。
DOWN_BEFORE_RESTART = 3

# これだけ黙ったら、まだ直している途中でも知らせる。
# 復旧は3〜5分で終わらせる前提なので、それを超えたら異常事態として扱う。
# 「30分止まっていました」と後から知るのが一番困る。
TELL_AFTER = 5 * 60
# 入れ直したあと、次に入れ直してよくなるまでの間。
RESTART_COOLDOWN = 900





def restart_gateway(wait=30):
    """入れ直して、**本当に戻ったかどうかを確かめてから**返す。"""
    kickstart(GATEWAY_LABEL)
    deadline = time.time() + wait
    while time.time() < deadline:
        if port_open(GATEWAY_PORT):
            return True
        time.sleep(1)
    return False


def rollback_config():
    """設定を「動いた形」に戻して、もう一度入れ直す。

    入れ直しても戻らないときの次の手。原因の多くは設定なので、
    決めてある形に戻すのが、いちばん確実で結果の読める手当てになる。
    config-guard が戻す前のものも残すので、あとから原因を追える。

    **判断で直そうとしない。**ここは「決めてある形に戻す」だけにする。
    考えて直すのは、この先の段で人か qwc がやること。"""
    guard = os.path.expanduser("~/bin/config-guard")
    if not os.path.exists(guard):
        return False, "config-guard が無い"
    r = subprocess.run([guard, "--rollback", "--quiet"],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        return False, "戻せなかった（動いた形がまだ無い可能性）"
    if not restart_gateway(60):
        return False, "戻したが、それでも上がらない"
    return True, "設定を動いた形に戻した"


def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=2):
            return True
    except OSError:
        return False


def gateway_health():
    """(状態, 説明) を返す。状態は "ok" / "degraded" / "silent" / "skip"。

    degraded を分けているのは、openclaw 自身がそう名乗るからである。
    実際に gateway を止めて再開させたとき、
      Gateway event loop: degraded reasons=event_loop_delay max=11769ms
    と出て、20秒ほどで max=23ms の ok に戻った。
    数字は今の窓のもので、詰まりが取れれば自分で戻る。
    つまり「詰まりかけ」を捕まえられる本物の信号で、
    答えないより手前の段階として使える。ただし一瞬なら勝手に戻るので、
    ここで即入れ直すと、治りかけの相手を毎回切ることになる。
    """
    if not port_open(GATEWAY_PORT):
        return "down", "止まっている（まず line-guard の担当）"

    env = dict(os.environ)
    env["PATH"] = BREW_BIN + ":" + env.get("PATH", "/usr/bin:/bin")
    try:
        r = subprocess.run([OPENCLAW, "health"], capture_output=True, text=True,
                           timeout=HEALTH_TIMEOUT, env=env)
    except subprocess.TimeoutExpired:
        return "silent", f"health が {HEALTH_TIMEOUT} 秒返らない"
    except OSError as e:
        return "skip", f"health を呼べない（{e}）"

    if r.returncode != 0:
        return "silent", f"health が失敗した (exit {r.returncode})"
    for row in r.stdout.splitlines():
        if row.startswith("Gateway event loop"):
            detail = row.strip()
            return ("degraded" if "degraded" in detail else "ok"), detail
    return "silent", "health に gateway の行が出ない"





def main():
    args = set(sys.argv[1:])
    dry = "--dry-run" in args

    # 調べるだけのときは、走っている相手の邪魔をしないので鍵は要らない。
    if not dry and "--report" not in args and "--check" not in args:
        if not G.hold_lock():
            return 0
    state = G.load_state()
    now = datetime.now()
    troubles = []

    # 1. model-guard は走り続けているか
    age = pulse_age("model-guard")
    if age is None:
        mg = "一度も走っていない"
    elif age > MODEL_GUARD_STALE:
        mg = f"{int(age // 60)}分止まっている"
    else:
        mg = f"{int(age)} 秒前に走った"

    if age is None or age > MODEL_GUARD_STALE:
        troubles.append(f"model-guard が{mg}")
        if not dry:
            ok = kickstart(MODEL_GUARD_LABEL)
            G.log(f"model-guard が{mg} → 蹴った（{'成功' if ok else '失敗'}）")
            if not state.get("mg_told"):
                G.notify(f"見張り（model-guard）が{mg}ので蹴り直しました。"
                       f"\nこれが黙っているあいだ、ローカルのモデルは誰も見ていません。")
                state["mg_told"] = True
    else:
        state.pop("mg_told", None)

    # 2. line-guard は走り続けているか
    #
    # LINE の入り口を守っているのはこれ1つで、これが黙ると
    # 「入り口が切れたことに誰も気づかない」状態になる。
    lg_age = pulse_age("line-guard")
    if lg_age is None:
        lg = "まだ心拍が無い"
    elif lg_age > LINE_GUARD_STALE:
        lg = f"{int(lg_age // 60)}分止まっている"
    else:
        lg = f"{int(lg_age)}秒前に走った"

    if lg_age is not None and lg_age > LINE_GUARD_STALE:
        troubles.append(f"line-guard が{lg}")
        if not dry:
            ok = kickstart(LINE_GUARD_LABEL)
            G.log(f"line-guard が{lg} → 蹴った（{'成功' if ok else '失敗'}）")
            if not state.get("lg_told"):
                G.notify(f"見張り（line-guard）が{lg}ので蹴り直しました。"
                       f"\nこれが黙っているあいだ、LINEの入り口は誰も見ていません。")
                state["lg_told"] = True
    else:
        state.pop("lg_told", None)

    # 3. qwc-guard は走り続けているか
    #
    # ここだけは蹴っても直らない（qwc は常駐していないので、直す相手がいない）。
    # それでも見ているのは、「見張りが止まっていた」と「qwc は無事だった」を
    # 取り違えないため。走っていないなら、無事だと分かっているわけではない。
    qg_age = pulse_age("qwc-guard")
    if qg_age is None:
        qg = "まだ心拍が無い"
    elif qg_age > QWC_GUARD_STALE:
        qg = f"{int(qg_age // 3600)}時間止まっている"
    else:
        qg = f"{int(qg_age // 60)}分前に走った"

    if qg_age is not None and qg_age > QWC_GUARD_STALE:
        troubles.append(f"qwc-guard が{qg}")
        if not dry:
            kickstart(QWC_GUARD_LABEL)
            G.log(f"qwc-guard が{qg} → 蹴った")

    # 4. gateway は立っているのに黙っていないか
    status, detail = gateway_health()
    if status in ("ok", "skip"):
        for k in ("gw_silent", "gw_degraded", "gw_down"):
            state[k] = 0
        state.pop("gw_restarted_at", None)
        state.pop("gw_down_since", None)
        state.pop("gw_told", None)
        # 元気なうちに「動いた形」を更新しておく。
        # 動いていることを確かめられるのは今この瞬間だけで、
        # 壊れてからでは「どの形なら動いたのか」が分からない。
        # 毎回やると重いので1日1回。
        today = now.strftime("%Y-%m-%d")
        # --check や --report は「調べるだけ」。ここで書き込むと、
        # 呼んだ相手に副作用が返る。
        if (status == "ok" and state.get("good_saved") != today
                and not dry and not args & {"--check", "--report"}):
            cg = os.path.expanduser("~/bin/config-guard")
            if os.path.exists(cg):
                subprocess.run([cg, "--save"], capture_output=True, timeout=300)
                state["good_saved"] = today
    else:
        key = {"silent": "gw_silent", "degraded": "gw_degraded", "down": "gw_down"}[status]
        limit = {"silent": SILENT_BEFORE_RESTART,
                 "degraded": DEGRADED_BEFORE_RESTART,
                 "down": DOWN_BEFORE_RESTART}[status]
        count = int(state.get(key, 0)) + 1
        state[key] = count
        # ひとつが続いているあいだ、ほかは数えない
        for k in ("gw_silent", "gw_degraded", "gw_down"):
            if k != key:
                state[k] = 0
        troubles.append(f"gateway が{detail}（連続 {count} 回）")

        # 何回目かではなく、何分黙っているかで知らせる。
        since = state.get("gw_down_since")
        if not since:
            since = now.isoformat(timespec="seconds")
            state["gw_down_since"] = since
        try:
            mins = int((now - datetime.fromisoformat(since)).total_seconds()) // 60
        except ValueError:
            mins = 0
        if mins * 60 >= TELL_AFTER and not state.get("gw_told") and not dry:
            state["gw_told"] = True
            G.notify(f"gateway が {mins} 分応答していません（{detail}）。"
                     f"\nまだ直そうとしていますが、時間がかかっています。")
            G.log(f"{mins}分 黙っているので途中で知らせた")

        last = state.get("gw_restarted_at")
        recent = False
        if last:
            try:
                recent = (now - datetime.fromisoformat(last)).total_seconds() < RESTART_COOLDOWN
            except ValueError:
                recent = False

        if dry or count < limit:
            G.log(f"gateway が{status}（{detail}・連続 {count} 回）")
        elif recent:
            G.log(f"gateway が{status}（{detail}）だが、入れ直した直後なので待つ")
        else:
            state["gw_restarted_at"] = now.isoformat(timespec="seconds")
            state[key] = 0
            came_back = restart_gateway()
            if came_back:
                G.log(f"gateway が{status}のまま {count} 回（{detail}） → 入れ直して戻った")
                G.notify(f"gateway が {count} 回続けて応答しなかったので入れ直しました。"
                       f"\n  {detail}"
                       f"\nこの間の Discord と LINE は届いていないはずです。")
            else:
                # 入れ直しても戻らない。次の手は「設定を動いた形に戻す」。
                # 原因の多くは設定で、決めてある形に戻すのが結果の読める手当てになる。
                G.log(f"gateway が{status}のまま {count} 回（{detail}） → 入れ直しでは戻らなかった")
                rolled, how = rollback_config()
                if rolled:
                    G.log("設定を動いた形に戻して復旧した")
                    G.notify("gateway が入れ直しても戻らなかったので、設定を動いた形に戻しました。"
                             f"\n  {detail}"
                             "\n戻す前の設定は残してあります: config-guard --log")
                else:
                    G.log(f"設定を戻しても復旧できなかった（{how}）")
                    G.notify(f"gateway が入れ直しても設定を戻しても戻りません（{how}）。"
                             f"\n  {detail}"
                             "\n手で見てください: claw status / config-guard --log")

    G.save_state(state)
    G.beat()

    if "--check" in args:
        print("NG " + " / ".join(troubles) if troubles else "OK")
    elif "--report" in args:
        print(f"model-guard : {mg}")
        print(f"line-guard  : {lg}")
        print(f"qwc-guard   : {qg}")
        print(f"gateway     : {detail}")
        wd = pulse_age("watchdog")
        print(f"watchdog    : いま走った（前回は {int(wd)} 秒前）" if wd is not None else "watchdog    : 初回")
    elif dry and troubles:
        print("[dry-run] " + " / ".join(troubles))

    return 1 if troubles else 0


if __name__ == "__main__":
    sys.exit(main())
